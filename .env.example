# snak environment template.
# Copy to .env and fill in database.default.password locally. Never commit .env.

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://snak.local/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.appTimezone = 'America/La_Paz'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = snak
database.default.username = snak
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

#--------------------------------------------------------------------
# TEST DATABASE (PHPUnit only; never point this at the live database)
#--------------------------------------------------------------------
# Copy these keys to `.env.testing` and fill in the password locally.
# `.env.testing` is gitignored and takes precedence over `.env` in tests.

database.tests.hostname = 127.0.0.1
database.tests.database = snak_test
database.tests.username = snak
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# COOKIES
#--------------------------------------------------------------------
# Send cookies only over HTTPS. Leave false for local HTTP development and
# set true in production before exposing the login page.

cookie.secure = false
